 src/lib/site.ts                               |  4 +-
 src/routes/admin.tsx                          | 87 ++++++++++++++++++-
 .../20260804160000_update_whatsapp_number.sql | 12 +++
 3 files changed, 99 insertions(+), 4 deletions(-)
 create mode 100644 supabase/migrations/20260804160000_update_whatsapp_number.sql

diff --git a/src/lib/site.ts b/src/lib/site.ts
index ec913e1..424e145 100644
